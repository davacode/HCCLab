<%- include('./layouts/header') %>
<h1>Dashboard</h1>
<div class="dashboard">

    <!-- Courses Section -->
    <div class="dropdown">
        <button class="dropbtn">Courses</button>
        <div class="dropdown-content">
            <a href="/courses/add">Add Course</a>
            <a href="/courses/list">List Courses</a>
        </div>
    </div>

    <!-- Enrollments Section -->
    <div class="dropdown">
        <button class="dropbtn">Enrollments</button>
        <div class="dropdown-content">
            <a href="/enrollments/add">Add Enrollment</a>
            <a href="/enrollments/list">List Enrollments</a>
        </div>
    </div>

    <!-- Faculty Section -->
    <div class="dropdown">
        <button class="dropbtn">Faculty</button>
        <div class="dropdown-content">
            <a href="/faculty/add">Add Faculty</a>
            <a href="/faculty/list">List Faculty</a>
        </div>
    </div>

    <!-- Students Section -->
    <div class="dropdown">
        <button class="dropbtn">Students</button>
        <div class="dropdown-content">
            <a href="/students/add">Add Student</a>
            <a href="/students/list">List Students</a>
        </div>
    </div>

    <!-- Users Section -->
    <div class="dropdown">
        <button class="dropbtn">Users</button>
        <div class="dropdown-content">
            <a href="/users/add">Add User</a>
            <a href="/users/list">List Users</a>
        </div>
    </div>

    <div class="dashboard">
    <!-- Existing dashboard content here -->

    <!-- Logout Button -->
    <form method="GET" action="/users/logout" style="margin-top: 20px;">
        <button type="submit" class="logout-btn">Logout</button>
    </form>
</div>

</div>

<!-- CSS Styling -->
<style>
    .dashboard {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .dropdown {
        position: relative;
        display: inline-block;
    }

    .dropbtn {
        background-color: #4CAF50;
        color: white;
        padding: 10px 20px;
        font-size: 16px;
        border: none;
        cursor: pointer;
        border-radius: 5px;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        background-color: #f9f9f9;
        min-width: 160px;
        box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
        z-index: 1;
        border-radius: 5px;
    }

    .dropdown-content a {
        color: black;
        padding: 12px 16px;
        text-decoration: none;
        display: block;
    }

    .dropdown-content a:hover {
        background-color: #f1f1f1;
    }

    .dropdown:hover .dropdown-content {
        display: block;
    }

    .dropdown:hover .dropbtn {
        background-color: #3e8e41;
    }
</style>

<%- include('./layouts/footer') %>
