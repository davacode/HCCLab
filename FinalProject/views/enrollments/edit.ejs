<%- include('../layouts/header') %>
<div>
<h1>Edit Enrollment</h1>
<form method="POST" action="/enrollments/edit/<%= enrollment.enrollment_id %>">
    <label>Student ID:</label>
    <input type="text" name="student_id" value="<%= enrollment.student_id %>" required />
    <label>Faculty ID:</label>
    <input type="text" name="faculty_id" value="<%= enrollment.faculty_id %>" required />
    <label>Course ID:</label>
    <input type="text" name="course_id" value="<%= enrollment.course_id %>" required />
    <button type="submit">Update Enrollment</button>
</form>
</div>
<%- include('../layouts/footer') %>
